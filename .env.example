# Foodie App Environment Variables

# Google OAuth2 (required)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Server port (optional, default 9090)
# PORT=9090

# Database (optional, defaults to a local H2 file in ./data)
# DATABASE_URL=jdbc:postgresql://localhost:5432/foodie
# DATABASE_DRIVER=org.postgresql.Driver
# DATABASE_USER=your_username
# DATABASE_PASSWORD=your_password
# JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
# Required with PostgreSQL (the app refuses to start without them): Flyway owns the schema and
# Hibernate only checks it.
# FLYWAY_ENABLED=true
# DDL_AUTO=validate

# Cloudflare Workers AI (optional, enables photo and recipe analysis)
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_API_TOKEN=your_api_token

# Admin email for usage monitoring (optional)
# ADMIN_EMAIL=you@example.com